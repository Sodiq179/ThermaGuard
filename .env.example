# Copy to .env to override defaults. All values are optional.

# Port the dashboard is served on (http://localhost:8080)
WEB_PORT=8080
# Port for the backend API docs (http://localhost:8000/docs)
API_PORT=8000
# Port where real devices connect to the MQTT broker
MQTT_PORT=1883

SITE_NAME=ThermaGuard Demo Site, Dammam
# Initial simulator scenario: normal_day | midday_peak | hot_zone_escalation | worker_overheating | sensor_dropout
SIM_SCENARIO=normal_day
# Scenario clock speed (1-20). Changeable live from the Simulator page.
SIM_SPEED=5
